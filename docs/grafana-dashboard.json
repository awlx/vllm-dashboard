          "sort": "desc"
        }
      }
    },
    {
      "id": 26,
      "title": "Request completion",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "Completed requests / preemptions per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(vllm_dashboard_model_requests_completed_total{job=\"$job\",instance=\"$instance\",node=~\"$node\",model=~\"$model\"}[$__rate_interval])",
          "legendFormat": "{{model}} completed"
        },
        {
          "refId": "B",
          "expr": "rate(vllm_dashboard_model_preemptions_total{job=\"$job\",instance=\"$instance\",node=~\"$node\",model=~\"$model\"}[$__rate_interval])",
          "legendFormat": "{{model}} preemptions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
