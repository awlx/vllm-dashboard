            }
          }
        },
        {
          "id": 11,
          "title": "Host memory",
          "description": "Host used memory is MemTotal minus MemAvailable. Each host is counted once, even when models share it.",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 54,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "vllm_dashboard_node_memory_used_bytes{job=\"$job\",instance=\"$instance\",node=~\"$node\"}",
              "legendFormat": "{{node}} used"
            },
