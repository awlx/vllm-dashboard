      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vllm_dashboard_model_speculative_acceptance_ratio{job=\"$job\",instance=\"$instance\",node=~\"$node\",model=~\"$model\"}",
          "legendFormat": "{{model}} speculative"
        }
      ],
