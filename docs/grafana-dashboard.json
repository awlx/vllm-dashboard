            }
          }
        },
        {
          "id": 17,
          "title": "GPU utilization",
          "type": "timeseries",
          "gridPos": {
            "x": 12,
            "y": 46,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "vllm_dashboard_node_gpu_utilization_ratio{job=\"$job\",instance=\"$instance\",node=~\"$node\"}",
