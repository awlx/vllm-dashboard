    {
      "id": 27,
      "title": "Host resources",
      "type": "row",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 16,
          "title": "CPU utilization",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 46,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "vllm_dashboard_node_cpu_utilization_ratio{job=\"$job\",instance=\"$instance\",node=~\"$node\"}",
